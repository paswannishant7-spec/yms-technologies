# Use the verified HTTPS origin for canonical URLs and sitemap links.
SITE_URL=
BUSINESS_LEGAL_NAME=
BUSINESS_REGISTERED_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=
SUPPORT_EMAIL=
GOOGLE_SITE_VERIFICATION=

# First-party or contracted HTTPS receiver. Success is acknowledged only on a 2xx response.
FORM_DELIVERY_URL=
FORM_DELIVERY_TOKEN=

# Set both to enable shared rate limiting across instances.
RATE_LIMIT_REST_URL=
RATE_LIMIT_REST_TOKEN=
# Optional. Set only to a header your ingress overwrites with a trusted client IP.
FORM_CLIENT_IP_HEADER=

# Optional approved content gate. Each approved entry still needs reviewed content.
CAREER_APPLICATIONS_ENABLED=
ONE_SEARCH_DELETION_ENABLED=
